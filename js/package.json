{
  "name": "kasera-pay",
  "version": "0.1.1",
  "description": "Official JavaScript/TypeScript SDK for Kasera Pay: accept QRIS and Virtual Account payments in Indonesia.",
  "keywords": ["kasera", "payment", "payment-gateway", "qris", "virtual-account", "indonesia"],
  "homepage": "https://pay.kasera.id",
  "repository": { "type": "git", "url": "git+https://github.com/getkasera/kasera-pay-sdk.git", "directory": "js" },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "gen": "openapi-typescript ../openapi.json -o src/schema.d.ts",
    "build": "tsc && cp src/schema.d.ts dist/",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2"
  }
}
